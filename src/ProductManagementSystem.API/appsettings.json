{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Constr": "Server=LENOVO;Database=ProductManagementSystemDB;TrustServerCertificate=True;Trusted_Connection=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },
  "Jwt": {
    "Issuer": "ProductManagementSystem",
    "Audience": "ProductManagementSystem.Client",
    "SigningKey": "phase-one-development-signing-key-placeholder-change-before-production",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "PolicyName": "DefaultCorsPolicy",
    "AllowedOrigins": [
      "https://localhost:7169",
      "http://localhost:5019"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "SecurityHeaders": {
    "ContentSecurityPolicy": "default-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self';",
    "ReferrerPolicy": "no-referrer",
    "PermissionsPolicy": "geolocation=(), microphone=(), camera=()"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Properties": {
      "Application": "ProductManagementSystem.API"
    }
  }
}
